{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hadavi-enterprises",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "workers_dev": true
}
